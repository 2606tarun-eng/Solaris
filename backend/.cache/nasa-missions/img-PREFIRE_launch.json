://images-assets.nasa.gov/image/KSC-20240605-PH-RKL01_0004/KSC-20240605-PH-RKL01_0004~large.jpg","rel":"alternate","render":"image","width":1269,"size":91000,"height":1920},{"href":"https://images-assets.nasa.gov/image/KSC-20240605-PH-RKL01_0004/KSC-20240605-PH-RKL01_0004~orig.jpg","rel":"canonical","render":"image","height":2048,"width":1354,"size":1069056}]},{"href":"https://images-assets.nasa.gov/image/KSC-20240605-PH-RKL01_0005/collection.json","data":[{"album":["Rocket_Lab_PREFIRE"],"center":"KSC","date_created":"2024-06-05T00:00:00Z","description":"Rocket Lab’s Electron rocket called “PREFIRE and Ice,” lifts off from Launch Complex 1 in Māhia, New Zealand at 3:15 p.m. NZST Wednesday, June 5, 2024 (11:15 p.m. EDT, Tuesday, June 4), on the second of two launches for NASA’s PREFIRE (Polar Radiant Energy in the Far-InfraRed Experiment). The PREFIRE mission, expected to last at least 10 months, consists of sending two CubeSats to asynchronous, near-polar orbits, to help close a gap in our understanding of how much of Earth’s heat is lost to space from the Arctic and Antarctica.","keywords":["NASA","PREFIRE","Polar Radiant Energy in the Far InfraRed Experiment","LSP","Launch Services Program","JPL","Jet Propulsion Laboratory","Earth","climate","CubeSat","small satellite","sea ice","melting","global warming","arctic","tropics","poles","Rocket Lab","Electron","New Zealand","Ready Aim PREFIRE","PREFIRE and Ice"],"location":"Launch Complex 1, New Zealand","media_type":"image","nasa_id":"KSC-20240605-PH-RKL01_0005","photographer":"Rocket Lab","title":"Rocket Lab PREFIRE and Ice Launch"}],"links":[{"href":"https://images-assets.nasa.gov/image/KSC-20240605-PH-RKL01_0005/KSC-20240605-PH-RKL01_0005~medium.jpg","rel":"alternate","render":"image","width":853,"size":57000,"height":1280},{"href":"https://images-assets.nasa.gov/image/KSC-20240605-PH-RKL01_0005/KSC-20240605-PH-RKL01_0005~small.jpg","rel":"alternate","render":"image","width":426,"size":13000,"height":640},{"href":"