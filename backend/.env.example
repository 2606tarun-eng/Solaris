# Backend configuration
PORT=3001
DATABASE_URL=./data/solaris.db

# NASA API (DEMO_KEY works but is rate-limited; get a free key at https://api.nasa.gov)
NASA_API_KEY=DEMO_KEY

# AI
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Cloudflare R2 (for voice audio storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=solaris-voice

# Admin
ADMIN_API_KEY=change-me
